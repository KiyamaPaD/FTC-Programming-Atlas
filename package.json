{
  "name": "ftc-programming-atlas",
  "version": "1.3.0",
  "private": true,
  "description": "FTC Programming Atlas web and native mobile application",
  "scripts": {
    "release:check": "node scripts/release-check.mjs && npm run mobile:build",
    "mobile:build": "node scripts/build-mobile-web.mjs",
    "mobile:doctor": "npx cap doctor",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "android:init": "npm run mobile:build && npx cap add android && npm run android:assets",
    "android:add": "npm run mobile:build && npx cap add android",
    "android:assets": "npx @capacitor/assets generate --android --iconBackgroundColor=\"#000000\" --iconBackgroundColorDark=\"#000000\" --splashBackgroundColor=\"#000000\" --splashBackgroundColorDark=\"#000000\"",
    "android:open": "npm run mobile:sync && npx cap open android",
    "android:run": "npm run mobile:sync && npx cap run android",
    "android:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "ios:init": "npm run mobile:build && npx cap add ios && npm run ios:assets",
    "ios:add": "npm run mobile:build && npx cap add ios",
    "ios:assets": "npx @capacitor/assets generate --ios --iconBackgroundColor=\"#000000\" --iconBackgroundColorDark=\"#000000\" --splashBackgroundColor=\"#000000\" --splashBackgroundColorDark=\"#000000\"",
    "ios:sync": "npm run mobile:build && npx cap sync ios",
    "ios:doctor": "node scripts/ios-preflight.mjs && npx cap doctor ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:run": "npm run ios:sync && npx cap run ios",
    "desktop:dev": "npm run mobile:build && electron .",
    "desktop:pack": "npm run mobile:build && electron-builder --win dir",
    "desktop:exe": "npm run mobile:build && electron-builder --win nsis",
    "desktop:portable": "npm run mobile:build && electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "electron": "44.4.2",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.ftcprogrammingatlas.desktop",
    "productName": "FTC Programming Atlas",
    "asar": true,
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FTC-Programming-Atlas-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FTC Programming Atlas",
      "deleteAppDataOnUninstall": false
    }
  }
}
